#!/bin/sh
# Pre-commit hook - lint les fichiers stagés

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "🔍 Running lint check..."

# Lint uniquement les fichiers TypeScript/TSX stagés
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$')

if [ -n "$STAGED_FILES" ]; then
  pnpm lint --quiet
  
  if [ $? -ne 0 ]; then
    echo "${RED}❌ Lint failed. Fix errors before committing.${NC}"
    echo "Run: pnpm lint --fix"
    exit 1
  fi
fi

echo "${GREEN}✅ Lint passed${NC}"
exit 0
