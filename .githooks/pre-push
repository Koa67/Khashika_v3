#!/bin/sh
# Pre-push hook - build check avant push

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🏗️  Running build check before push..."

# Build check
pnpm build > /dev/null 2>&1

if [ $? -ne 0 ]; then
  echo "${RED}❌ Build failed. Fix before pushing.${NC}"
  echo "Run: pnpm build"
  exit 1
fi

echo "${GREEN}✅ Build OK - pushing...${NC}"
exit 0
