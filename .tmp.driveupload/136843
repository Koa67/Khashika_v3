#!/usr/bin/env python3
"""
Script pour vérifier et corriger les duplications d'images
"""
import json
import os

def check_duplicates():
    json_path = "lib/data/products-ultimate.json"
    
    # Charger les données
    with open(json_path, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    # Analyser les duplications dans l'image principale
    main_image_usage = {}
    for product in data['products']:
        img = product.get('image', '')
        if img:
            main_image_usage.setdefault(img, []).append(product['id'])
    
    duplicates_main = {img: ids for img, ids in main_image_usage.items() if len(ids) > 1}
    
    # Analyser les duplications dans les arrays
    array_image_usage = {}
    for product in data['products']:
        if 'images' in product and isinstance(product['images'], list):
            for img in product['images']:
                if img.startswith('/images/products/'):
                    array_image_usage.setdefault(img, []).append(product['id'])
    
    duplicates_array = {img: ids for img, ids in array_image_usage.items() if len(ids) > 1}
    
    print(f"📊 ANALYSE DES DUPLICATIONS:")
    print(f"   Images principales uniques: {len(main_image_usage)}")
    print(f"   Images principales dupliquées: {len(duplicates_main)}")
    print(f"   Images dans arrays uniques: {len(array_image_usage)}")
    print(f"   Images dans arrays dupliquées: {len(duplicates_array)}")
    
    if duplicates_main:
        print(f"\n⚠️  Images principales dupliquées:")
        for img, ids in list(duplicates_main.items())[:5]:
            print(f"   {img}: utilisé par {len(ids)} produits")
            for pid in ids[:3]:
                print(f"      - {pid}")
    
    if duplicates_array:
        print(f"\n⚠️  Images dans arrays dupliquées (top 5):")
        sorted_dups = sorted(duplicates_array.items(), key=lambda x: len(x[1]), reverse=True)
        for img, ids in sorted_dups[:5]:
            print(f"   {img}: utilisé par {len(ids)} produits")
    
    # Note: Les duplications ne sont pas nécessairement un problème
    # (plusieurs produits peuvent partager la même image)
    # Mais on les signale pour information
    
    return {
        'main_duplicates': len(duplicates_main),
        'array_duplicates': len(duplicates_array),
        'details': {
            'main': duplicates_main,
            'array': dict(list(duplicates_array.items())[:10])
        }
    }

if __name__ == "__main__":
    print("=" * 70)
    print("🔍 VÉRIFICATION DES DUPLICATIONS")
    print("=" * 70)
    result = check_duplicates()
    print("=" * 70)
    if result['main_duplicates'] == 0 and result['array_duplicates'] == 0:
        print("✅ Aucune duplication détectée!")
    else:
        print("ℹ️  Des duplications ont été détectées (peut être normal)")





