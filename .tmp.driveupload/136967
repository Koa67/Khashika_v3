#!/bin/bash

# Script de nettoyage profond pour forcer la régénération du cache
# Usage: bash run_hard_reset.sh

set -e  # Arrêter en cas d'erreur

echo "🧹 NETTOYAGE PROFOND DU CACHE"
echo "=========================================="
echo ""

# Étape 1 : Supprimer le cache Next.js
echo "📋 Étape 1 : Suppression du cache Next.js (.next)..."
if [ -d ".next" ]; then
    rm -rf .next
    echo "   ✅ Cache .next supprimé"
else
    echo "   ℹ️  Dossier .next introuvable (déjà supprimé ou n'existe pas)"
fi
echo ""

# Étape 2 : Supprimer le cache node_modules
echo "📋 Étape 2 : Suppression du cache node_modules..."
if [ -d "node_modules/.cache" ]; then
    rm -rf node_modules/.cache
    echo "   ✅ Cache node_modules/.cache supprimé"
else
    echo "   ℹ️  Dossier node_modules/.cache introuvable (déjà supprimé ou n'existe pas)"
fi
echo ""

# Étape 3 : Relancer le serveur
echo "📋 Étape 3 : Relance du serveur de développement..."
echo "   ▶️  Exécution de: npm run dev"
echo ""
npm run dev





