ey={col.name}>\n                            <a\n                              href={col.link}\n                              className=\"font-body text-sm text-gray-700 hover:text-primary transition-colors\"\n                            >\n                              {col.name}\n                            </a>\n                          </li>\n                        ))}\n                      </ul>\n                    </div>\n\n                    {/* Services */}\n                    <div>\n                      <h3 className=\"font-heading text-lg font-semibold text-secondary mb-3\">\n                        Services\n                      </h3>\n                      <ul className=\"space-y-2\">\n                        {services.map((serv) => (\n                          <li key={serv.name}>\n                            <a\n                              href={serv.link}\n                              className=\"font-body text-sm text-gray-700 hover:text-primary transition-colors\"\n                            >\n                              {serv.name}\n                            </a>\n                          </li>\n                        ))}\n                      </ul>\n                    </div>\n                  </div>\n\n                </div>\n              )}\n            </div>\n            <Link\n              href=\"/contact\"\n              className=\"text-gray-700 hover:text-primary transition-colors duration-200 relative group px-3 py-2 font-body\"\n            >\n              <span>Contact</span>\n              <span className=\"absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full\"></span>\n            </Link>\n          </div>\n\n          {/* Barre de recherche et actions */}\n          <div className=\"flex items-center gap-4\">\n            {/* Recherche Desktop */}\n            <div className=\"hidden md:flex items-center gap-2\">\n              <button\n                onClick={() => setShowSearch(!showSearch)}\n                className=\"transition-colors duration-200 hover:text-primary focus:underline focus:outline-none focus:ring-2 focus:ring-primary/50 rounded p-2 text-gray-600\"\n                aria-label=\"Rechercher un produit\"\n              >\n                <span aria-hidden=\"true\">🔍</span>\n              </button>\n              {showSearch && (\n                <input\n                  type=\"text\"\n                  placeholder=\"Rechercher...\"\n                  className=\"px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\"\n                  autoFocus\n                />\n              )}\n            </div>\n\n            {/* Recherche Mobile */}\n            <button\n              onClick={() => setShowSearch(!showSearch)}\n              className=\"md:hidden p-2 text-gray-600 hover:text-primary transition-colors\"\n              aria-label=\"Rechercher\"\n            >\n              🔍\n            </button>\n          </div>\n        </div>\n\n        {/* Overlay recherche mobile */}\n        {showSearch && (\n          <div className=\"md:hidden fixed inset-0 bg-black/50 z-50 flex items-start justify-center pt-20\">\n            <div className=\"bg-white w-full max-w-md mx-4 rounded-lg p-4\">\n              <div className=\"flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Rechercher...\"\n                  className=\"flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\"\n                  autoFocus\n                />\n                <button\n                  onClick={() => setShowSearch(false)}\n                  className=\"p-2 text-gray-600 hover:text-primary\"\n                >\n                  ✕\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </nav>\n  );\n}\n"],"names":[],"mappin