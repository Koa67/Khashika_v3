@tailwind base;
@tailwind components;
@tailwind utilities;

/* Design System Global - Khashika */

/* Variables CSS */
:root {
  --font-serif: 'Playfair Display', serif;
  --font-sans: 'Montserrat', sans-serif;
  --turquoise: #2596be;
  --gold: #D4AF37;
  --coral: #FF6B6B;
  --background: #F8F8F8;
}

/* Polices */
body {
  font-family: var(--font-sans);
  color: #1f2937; /* text-gray-800 */
}

.font-serif {
  font-family: var(--font-serif);
}
.font-sans {
  font-family: var(--font-sans);
}

h1, h2, h3, h4, h5, h6, .font-heading {
  font-family: var(--font-serif);
  color: #111827; /* text-gray-900 */
}
/* Motif Indien Subtile */
.indian-pattern {
  background-image: url('/patterns/indian-motif.svg');
  background-repeat: repeat;
  opacity: 0.03;
}

.bg-pattern {
  background-image: url('/patterns/indian-motif.svg');
  background-repeat: repeat;
  opacity: 0.05;
}

/* Frise décorative Mughal/Zari en bas de la Navbar */
.pattern-mughal-bottom {
  position: relative;
}

.pattern-mughal-bottom::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(
    to right,
    transparent 0%,
    #D4AF37 10%,
    #2596be 20%,
    #D4AF37 30%,
    transparent 40%,
    transparent 60%,
    #D4AF37 70%,
    #2596be 80%,
    #D4AF37 90%,
    transparent 100%
  );
  background-size: 200% 100%;
  opacity: 0.6;
}
/* Couleur Corail pour les promotions */
.coral-bg {
  background-color: #FF6B6B;
}

.coral-text {
  color: #FF6B6B;
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }

}
.animate-fade-in {
  animation: fadeIn 0.6s ease-out forwards;
}

.animate-fade-in-down {
  animation: fadeInDown 0.6s ease-out forwards;
}
/* Accessibilité - Focus visible */
*:focus-visible {
  outline: 2px solid #2596be;
  outline-offset: 2px;
}






