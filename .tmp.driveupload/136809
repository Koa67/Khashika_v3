#!/usr/bin/env python3
"""
Script de vérification complète du processus de correction des images
"""
import json
import os
from pathlib import Path

def verify_process():
    print("=" * 70)
    print("🔍 VÉRIFICATION COMPLÈTE DU PROCESSUS")
    print("=" * 70)
    
    json_path = "lib/data/products-ultimate.json"
    backup_json = "lib/data/products-ultimate_backup.json"
    images_dir = "public/images/products"
    backup_dir = os.path.join(images_dir, 'backups')
    
    # 1. Vérifier les fichiers de backup
    print("\n📦 1. VÉRIFICATION DES BACKUPS")
    print("-" * 70)
    if os.path.exists(backup_json):
        size = os.path.getsize(backup_json) / 1024
        print(f"✅ Backup JSON existe: {backup_json} ({size:.1f} KB)")
    else:
        print(f"❌ Backup JSON manquant: {backup_json}")
    
    if os.path.exists(backup_dir):
        backup_count = sum(1 for _ in Path(backup_dir).rglob('*.jpg')) + \
                      sum(1 for _ in Path(backup_dir).rglob('*.jpeg')) + \
                      sum(1 for _ in Path(backup_dir).rglob('*.png'))
        print(f"✅ Dossier backup images existe: {backup_count} images")
    else:
        print(f"⚠️  Dossier backup images non trouvé: {backup_dir}")
    
    # 2. Charger les données
    print("\n📊 2. ANALYSE DES DONNÉES")
    print("-" * 70)
    with open(json_path, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    total_products = len(data['products'])
    print(f"Total produits: {total_products}")
    
    # 3. Vérifier les images
    products_with_image = []
    products_without_image = []
    products_bad_path = []
    missing_files = []
    valid_images = []
    
    for product in data['products']:
        img = product.get('image', '')
        if not img:
            products_without_image.append(product['id'])
        elif not img.startswith('/images/products/'):
            products_bad_path.append((product['id'], img))
        else:
            file_path = os.path.join('public', img.lstrip('/'))
            if os.path.exists(file_path):
                valid_images.append(product['id'])
                products_with_image.append(product)
            else:
                missing_files.append((product['id'], img))
    
    print(f"✅ Produits avec image valide: {len(valid_images)}/{total_products}")
    print(f"❌ Produits sans image: {len(products_without_image)}")
    print(f"⚠️  Produits avec chemin invalide: {len(products_bad_path)}")
    print(f"❌ Images référencées mais fichiers manquants: {len(missing_files)}")
    
    if missing_files:
        print("\n   Exemples d'images manquantes:")
        for pid, img in missing_files[:5]:
            print(f"   - {pid}: {img}")
    
    # 4. Vérifier les images dupliquées
    print("\n🔄 3. VÉRIFICATION DES DOUBLONS")
    print("-" * 70)
    image_usage = {}
    for product in data['products']:
        img = product.get('image', '')
        if img:
            image_usage.setdefault(img, []).append(product['id'])
    
    duplicates = {img: ids for img, ids in image_usage.items() if len(ids) > 1}
    print(f"Images uniques: {len(image_usage)}")
    print(f"Images dupliquées: {len(duplicates)}")
    
    if duplicates:
        print("\n   Exemples d'images dupliquées:")
        for img, ids in list(duplicates.items())[:3]:
            print(f"   - {img}: utilisé par {len(ids)} produits")
    
    # 5. Vérifier les images orphelines
    print("\n🗂️  4. VÉRIFICATION DES IMAGES ORPHELINES")
    print("-" * 70)
    all_images = set()
    for root, dirs, files in os.walk(images_dir):
        if 'backups' in root:
            continue
        for file in files:
            if file.lower().endswith(('.jpg', '.jpeg', '.png')):
                rel_path = os.path.join(root, file).replace(images_dir, '').lstrip('/')
                all_images.add(rel_path)
    
    referenced_images = set()
    for product in data['products']:
        img = product.get('image', '')
        if img and img.startswith('/images/products/'):
            ref_path = img.replace('/images/products/', '')
            referenced_images.add(ref_path)
    
    orphan_images = all_images - referenced_images
    print(f"Images totales dans products/: {len(all_images)}")
    print(f"Images référencées: {len(referenced_images)}")
    print(f"Images orphelines: {len(orphan_images)}")
    
    # 6. Vérifier les arrays d'images
    print("\n🖼️  5. VÉRIFICATION DES ARRAYS D'IMAGES")
    print("-" * 70)
    products_with_images_array = [p for p in data['products'] if p.get('images') and len(p.get('images', [])) > 0]
    total_images_in_arrays = sum(len(p.get('images', [])) for p in data['products'])
    print(f"Produits avec array d'images: {len(products_with_images_array)}/{total_products}")
    print(f"Total images dans arrays: {total_images_in_arrays}")
    
    # 7. Résumé final
    print("\n" + "=" * 70)
    print("📋 RÉSUMÉ FINAL")
    print("=" * 70)
    
    all_good = (
        len(products_without_image) == 0 and
        len(products_bad_path) == 0 and
        len(missing_files) == 0 and
        len(duplicates) == 0
    )
    
    if all_good:
        print("✅ TOUT EST CORRECT!")
        print(f"   - Tous les {total_products} produits ont une image valide")
        print(f"   - Aucune image dupliquée")
        print(f"   - Toutes les images référencées existent")
    else:
        print("⚠️  PROBLÈMES DÉTECTÉS:")
        if products_without_image:
            print(f"   - {len(products_without_image)} produits sans image")
        if products_bad_path:
            print(f"   - {len(products_bad_path)} produits avec chemin invalide")
        if missing_files:
            print(f"   - {len(missing_files)} images référencées mais fichiers manquants")
        if duplicates:
            print(f"   - {len(duplicates)} images dupliquées")
    
    print(f"\n📁 Images orphelines déplacées: {len(orphan_images)} → {backup_dir}")
    print("=" * 70)

if __name__ == "__main__":
    verify_process()





