    "@supabase/supabase-js": "^2.84.0",
    "@tanstack/react-table": "^8.21.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.555.0",
    "next": "16.0.10",
    "next-intl": "^4.6.1",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
