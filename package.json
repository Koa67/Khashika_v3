{
  "name": "khashika",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --no-error-on-unmatched-pattern --ignore-pattern '_tools/**' --ignore-pattern 'khashika-filters/**' --ignore-pattern 'khashika-image-fix/**' .",
    "ice-age": "tsx ./scripts/ice_age.ts",
    "scaffold": "tsx ./scripts/ice_age.ts component",
    "extract-prices": "tsx scripts/extract-prices.ts",
    "reformat-images": "tsx scripts/reformat-images.ts",
    "fix": "lsof -ti:3000 | xargs kill -9 || true; rm -rf .next; npm run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
